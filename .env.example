# Copy this file to .env and fill in your key to enable free-form question
# understanding in the Conversational Data Analyst. Without a key, the
# feature still works for common questions via its rule-based fast path.

# Which provider to use: "anthropic" (default) or "gemini"
LLM_PROVIDER=anthropic

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Gemini (only used if LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
